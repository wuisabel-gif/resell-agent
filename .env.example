# eBay app keys (developer.ebay.com -> My Account -> Application Keys)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# sandbox until you're ready to list for real; then production (needs Browse access approved)
EBAY_ENV=sandbox

# Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
# optional: override the vision/listing model
# ANTHROPIC_MODEL=claude-sonnet-5

# Posting only (see README "For posting"):
EBAY_REDIRECT_URI=
EBAY_USER_REFRESH_TOKEN=

# Set to 1 only after eBay approves Marketplace Insights (buy.marketplace.insights
# scope) for your app. Turns on real sold-comp pricing; otherwise leave blank.
# EBAY_INSIGHTS=1

# Set to 1 to pull Poshmark asking prices for the cross-platform comparison.
# WARNING: unofficial, against Poshmark's ToS, and fragile — account-ban risk is
# yours. Off by default. Leave blank unless you accept that.
# ENABLE_POSHMARK=1
