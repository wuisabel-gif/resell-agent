# eBay app keys (developer.ebay.com -> My Account -> Application Keys)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# sandbox until you're ready to list for real; then production (needs Browse access approved)
EBAY_ENV=sandbox

# Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
# For an Anthropic-compatible gateway instead, use its bearer token and base URL:
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=https://api.example.com
# optional: override the vision/listing model
# ANTHROPIC_MODEL=claude-sonnet-5

# Posting only (see README "For posting"):
EBAY_REDIRECT_URI=
EBAY_USER_REFRESH_TOKEN=

# Set to 1 only after eBay approves Marketplace Insights (buy.marketplace.insights
# scope) for your app. Turns on real sold-comp pricing; otherwise leave blank.
# EBAY_INSIGHTS=1

# Extra comparison sources. ALL are unofficial scrapers: against each platform's
# ToS, fragile, asking-prices-only, and off by default. Account/IP-ban risk is
# yours. Enable only the ones you accept.
# ENABLE_POSHMARK=1
# ENABLE_THREDUP=1
# ENABLE_THEREALREAL=1
# ENABLE_MERCARI=1

# Reverse-image brand lookup via an unofficial Google search-by-image scrape.
# Same risks as above (ToS, fragile, often blocked). Needs the photo at a PUBLIC
# URL, passed with `draft --image-url https://...`. Off by default.
# ENABLE_IMAGE_SEARCH=1

# Local CLIP visual brand match (our own, no scraping/key/ToS risk). Runs on the
# photo bytes; first run downloads ~150MB model. `npm i @xenova/transformers` first.
# When a brand-index.json exists (build it: `npm run index -- --dir refs`), it does
# nearest-neighbour against your own reference photos; otherwise it falls back to
# zero-shot against a curated house list.
# ENABLE_BRAND_MATCH=1
# BRAND_INDEX=brand-index.json    # path to the index file
# BRAND_MATCH_MIN=0.75            # min cosine similarity to accept a match

# Where the exact piece sells NEW (Google Shopping scrape, unofficial: ToS-risky,
# fragile, often blocked). Only runs when the vision step names an exact product.
# ENABLE_RETAIL=1

# Local review-and-publish GUI. By default it binds only to 127.0.0.1 and
# prints a URL without requiring you to type a token. API and photo requests
# use a private HttpOnly session cookie. GUI_HOST is ignored unless you explicitly
# opt into remote access with GUI_ALLOW_REMOTE=1.
# GUI_PORT=3000
# GUI_HOST=127.0.0.1
# GUI_ALLOW_REMOTE=1
# GUI_AUTH_TOKEN=       # optional; use a long random token when remote access is enabled
# GUI_DATA_DIR=/private/path/resell-agent-gui
# GUI_DEFAULT_SKU=       # optional stable SKU prefix; draft ID is appended
# GUI_DEFAULT_MERCHANT_LOCATION_KEY=
# GUI_DEFAULT_FULFILLMENT_POLICY_ID=
# GUI_DEFAULT_PAYMENT_POLICY_ID=
# GUI_DEFAULT_RETURN_POLICY_ID=
# GUI_DRAFT_TTL_MS=86400000

# Optional, opt-in Playwright flows for platforms without a public posting API.
# The JSON is a user-supplied flow; selectors are intentionally not hardcoded.
# ENABLE_BROWSER_AUTOMATION=1
# BROWSER_AUTOMATION_HEADFUL=1
# BROWSER_AUTOMATION_PROFILE_DIR=/private/path/playwright-profile
# POSHMARK_BROWSER_FLOW={"url":"https://poshmark.com/...","titleSelector":"...","descriptionSelector":"...","priceSelector":"...","imageInputSelector":"input[type=file]","publishSelector":"...","successSelector":"..."}
# DEPOP_BROWSER_FLOW={"url":"https://www.depop.com/...","titleSelector":"...","descriptionSelector":"...","priceSelector":"...","imageInputSelector":"input[type=file]","publishSelector":"...","successUrlIncludes":"/dashboard/..."}
